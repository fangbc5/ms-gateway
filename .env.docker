# ======== 基础配置 ========
# 日志级别
APP__LOG_LEVEL=info
# 服务监听地址
APP__SERVER__ADDR=0.0.0.0
APP__SERVER__PORT=8080
# JWT 密钥（与微服务统一）
APP__JWT_SECRET=d8u+T6OnBnfdKh5dmH7JT18BLkZ89eyXg6hbCpKohZk=
# 限流配置
APP__GLOBAL_QPS=1000
APP__CLIENT_QPS=100
# 请求超时（秒）
APP__REQUEST_TIMEOUT_SECS=10
# CORS 配置（* 表示允许所有源）
APP__CORS_ALLOWED_ORIGINS=*

# ======== Nacos 集成（可选） ========
APP__NACOS__ENABLED=true
APP__NACOS__SERVER_ADDRS=host.docker.internal:8848
APP__NACOS__USERNAME=nacos
APP__NACOS__PASSWORD=nacos
# 配置中心
APP__NACOS__CONFIG_NAMESPACE=0f158f76-45a3-4ce0-ae65-b1403594e420
APP__NACOS__ROUTES_DATA_ID=ms-gateway
# 服务注册/发现
APP__NACOS__NAMING_NAMESPACE=0f158f76-45a3-4ce0-ae65-b1403594e420
APP__NACOS__REGISTER_ENABLED=true
APP__NACOS__SERVICE_NAME=ms-gateway