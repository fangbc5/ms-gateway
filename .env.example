# Rust Gateway 环境配置示例
# 复制此文件为 .env 并填入实际配置值

# 网关监听地址
GATEWAY_BIND=0.0.0.0:8080

# JWT 解码密钥 (生产环境请使用强密钥)
JWT_DECODING_KEY=your-secret-key-here

# 全局 QPS 限制
GLOBAL_QPS=10000

# 单客户端 QPS 限制  
CLIENT_QPS=1000

# 请求超时时间(秒)
REQUEST_TIMEOUT_SECS=10

# 日志级别 (trace, debug, info, warn, error)
RUST_LOG=info

# CORS 允许的源（逗号分隔）
# 留空或不配置则允许所有源（不推荐用于生产）
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# ========== Nacos 集成（可选，默认关闭） ==========
# NACOS__ENABLED=true
# NACOS__SERVER_ADDRS=127.0.0.1:8848
# NACOS__USERNAME=nacos
# NACOS__PASSWORD=nacos

# ---- 配置中心命名空间 & 组 ----
# 用于路由规则等配置的读取
# NACOS__CONFIG_NAMESPACE=public
# NACOS__CONFIG_GROUP=DEFAULT_GROUP

# ---- 服务注册/发现命名空间 & 组 ----
# 用于服务注册和实例发现，与配置中心互不干扰
# NACOS__NAMING_NAMESPACE=public
# NACOS__NAMING_GROUP=DEFAULT_GROUP

# 网关自注册到 Nacos（使用 naming 命名空间）
# NACOS__REGISTER_ENABLED=false
# NACOS__SERVICE_NAME=ms-gateway

# 从 Nacos 读取路由规则（使用 config 命名空间，优先于本地 routes.toml，低于环境变量）
# NACOS__ROUTES_DATA_ID=ms-gateway-routes
# NACOS__ROUTES_GROUP=DEFAULT_GROUP
